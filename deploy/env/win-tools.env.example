# systemd EnvironmentFile syntax, not a shell script. Keep the real file mode 600.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=win_tools
DB_USERNAME=win_tools_app
DB_PASSWORD=<STRONG_PASSWORD>
SESSION_COOKIE_SECURE=true
SERVER_PORT=8080
WIN_TOOLS_LOG_DIR=/opt/win-tools/logs

# Disabled until FFmpeg, private storage, Nginx limits and ASF acceptance are verified.
# Conservative overrides for 2 CPU / 2 GiB RAM shared with MySQL; backend defaults differ.
WIN_TOOLS_VIDEO_CONVERTER_ENABLED=false
WIN_TOOLS_FFMPEG_PATH=/usr/bin/ffmpeg
WIN_TOOLS_FFPROBE_PATH=/usr/bin/ffprobe
WIN_TOOLS_VIDEO_CONVERTER_TEMP_DIR=/var/lib/win-tools/video-converter
# Pre-create with backend owner and 0700 on a disk-backed filesystem, not tmpfs.
SPRING_SERVLET_MULTIPART_LOCATION=/var/lib/win-tools/video-multipart
WIN_TOOLS_VIDEO_CONVERTER_MAX_UPLOAD_BYTES=524288000
WIN_TOOLS_VIDEO_CONVERTER_MAX_REQUEST_BYTES=526385152
WIN_TOOLS_VIDEO_CONVERTER_MAX_OUTPUT_BYTES=524288000
WIN_TOOLS_VIDEO_CONVERTER_MAX_DURATION_SECONDS=300
WIN_TOOLS_VIDEO_CONVERTER_TIMEOUT_SECONDS=300
WIN_TOOLS_VIDEO_CONVERTER_MAX_CONCURRENT_JOBS=1
WIN_TOOLS_VIDEO_CONVERTER_QUEUE_CAPACITY=1
WIN_TOOLS_VIDEO_CONVERTER_JOB_TTL_MINUTES=10
WIN_TOOLS_VIDEO_CONVERTER_MAX_RETAINED_JOBS=4

[Unit]
Description=Win Tools Spring Boot backend
After=network.target

[Service]
Type=simple
User=win-tools
Group=win-tools
WorkingDirectory=/opt/win-tools/backend
EnvironmentFile=/etc/win-tools/win-tools.env
Environment=WIN_TOOLS_LOG_DIR=/opt/win-tools/logs
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /opt/win-tools/backend/backend.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

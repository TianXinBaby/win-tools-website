# Include inside nginx.conf's http {} context. Replace example.com and TLS paths.
# Do not add location-level add_header directives: they override inherited headers.
# Operational access log excludes IP, URI, query, headers and request body.
log_format win_tools_ops '$time_iso8601 method=$request_method status=$status bytes=$body_bytes_sent request_time=$request_time upstream_status=$upstream_status';
# Vite emits content-hashed JS/CSS into /assets/. Keep other responses uncached
# unless the upstream sets its own Cache-Control (notably admin/CSRF responses).
map $uri $win_tools_cache_control {
    default "";
    / "no-cache";
    /index.html "no-cache";
    "~^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css)$" "public, max-age=31536000, immutable";
}
server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    server_tokens off;
    access_log /var/log/nginx/win-tools-access.log win_tools_ops;
    error_log /var/log/nginx/win-tools-error.log error;
    return 301 https://example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name example.com;
    server_tokens off;
    ssl_certificate /etc/nginx/ssl/example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/win-tools;
    index index.html;
    client_max_body_size 1m;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Nginx is the sole source of these headers on production responses.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header Cache-Control $win_tools_cache_control;
    # Enable only AFTER successful HTTPS validation; no includeSubDomains/preload.
    # add_header Strict-Transport-Security "max-age=86400" always;

    # The custom format omits request targets, client IP and credentials.
    access_log /var/log/nginx/win-tools-access.log win_tools_ops;
    error_log /var/log/nginx/win-tools-error.log error;

    # Inherit proxy settings in both API locations; preserve /api in upstream URI.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Single directly exposed Nginx: overwrite client-supplied forwarding headers.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header Strict-Transport-Security;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;

    location = /api {
        proxy_pass http://127.0.0.1:8080;
    }
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8080;
    }
    # Actuator is for loopback operators only; never route it from the public site.
    location = /actuator {
        return 404;
    }
    location ^~ /actuator/ {
        return 404;
    }
    location ~ /\. {
        deny all;
    }
    location /assets/ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
